<UserControl x:Class="RicosBetterFileSearch.WPF.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RicosBetterFileSearch.WPF.ViewModels"
             IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.DataContext>
        <x:Static Member="vm:ViewModelLocator.Search" />
    </UserControl.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Naziv fajla" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Width="250" VerticalContentAlignment="Center" Padding="4"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Ekstenzija" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                <TextBox Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" VerticalContentAlignment="Center" Padding="4"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Tag" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding AvailableTags}" SelectedItem="{Binding SelectedTag}"
                          DisplayMemberPath="Name" Width="120"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,4,0">
                <Button Content="Pretrazi" Command="{Binding SearchCommand}" Padding="12,4"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom">
                <Button Content="Ocisti" Command="{Binding ClearFiltersCommand}" Padding="8,4"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,0,0,4"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding SearchResults}"
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv fajla" Binding="{Binding FileName}" Width="200"/>
                <DataGridTextColumn Header="Putanja" Binding="{Binding FilePath}" Width="300"/>
                <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" Width="60"/>
                <DataGridTextColumn Header="Velicina" Binding="{Binding SizeInBytes, StringFormat='{}{0:N0} B'}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Istorija pretrage" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Obrisi istoriju" Command="{Binding ClearHistoryCommand}" Padding="8,2"/>
        </StackPanel>

        <DataGrid Grid.Row="4" ItemsSource="{Binding History}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Upit" Binding="{Binding Query}" Width="250"/>
                <DataGridTextColumn Header="Filter" Binding="{Binding ExtensionFilter}" Width="80"/>
                <DataGridTextColumn Header="Rezultata" Binding="{Binding ResultCount}" Width="70"/>
                <DataGridTextColumn Header="Vreme" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

