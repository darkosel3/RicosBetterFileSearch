<Window x:Class="RicosBetterFileSearch.WPF.Views.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rico Search" 
        Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Rico penguin palette -->
        <Color x:Key="RicoDark">#1a1a2e</Color>
        <Color x:Key="RicoMid">#16213e</Color>
        <Color x:Key="RicoAccent">#e94560</Color>
        <Color x:Key="RicoOrange">#f5a623</Color>
        <Color x:Key="RicoText">#eaeaea</Color>
        <Color x:Key="RicoSubtle">#8892b0</Color>

        <SolidColorBrush x:Key="RicoDarkBrush" Color="{StaticResource RicoDark}"/>
        <SolidColorBrush x:Key="RicoMidBrush" Color="{StaticResource RicoMid}"/>
        <SolidColorBrush x:Key="RicoAccentBrush" Color="{StaticResource RicoAccent}"/>
        <SolidColorBrush x:Key="RicoOrangeBrush" Color="{StaticResource RicoOrange}"/>
        <SolidColorBrush x:Key="RicoTextBrush" Color="{StaticResource RicoText}"/>
        <SolidColorBrush x:Key="RicoSubtleBrush" Color="{StaticResource RicoSubtle}"/>

        <!-- Result item style -->
        <Style x:Key="ResultItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#2a2a4a" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main container with shadow -->
    <Border CornerRadius="16" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Border CornerRadius="16" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource RicoDark}" Offset="0"/>
                    <GradientStop Color="{StaticResource RicoMid}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Rico branding -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,16,20,4">
                    <TextBlock Text="🐧" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Rico" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource RicoOrangeBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Search" FontSize="18" FontWeight="Light" 
                               Foreground="{StaticResource RicoTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock Text="  Kaboom!" FontSize="11" FontStyle="Italic"
                               Foreground="{StaticResource RicoSubtleBrush}" VerticalAlignment="Center" Margin="12,2,0,0"/>
                </StackPanel>

                <!-- Search input -->
                <Border Grid.Row="1" CornerRadius="12" Background="#0d1117" 
                        Margin="16,8,16,8" Padding="4">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{StaticResource RicoAccent}" />
                    </Border.BorderBrush>
                    <Border.BorderThickness>1.5</Border.BorderThickness>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍" FontSize="18" 
                                   VerticalAlignment="Center" Margin="12,0,8,0"/>

                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" FontWeight="Light"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource RicoTextBrush}"
                                 CaretBrush="{StaticResource RicoOrangeBrush}"
                                 VerticalContentAlignment="Center"
                                 Padding="4,10"
                                 TextChanged="SearchBox_TextChanged"/>

                        <TextBlock x:Name="Placeholder" Grid.Column="1" 
                                   Text="Type to search files... (Esc to close)"
                                   FontSize="18" FontWeight="Light"
                                   Foreground="#555" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="Visible"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                            <Border Background="#2a2a4a" CornerRadius="4" Padding="6,3" Margin="2">
                                <TextBlock Text="{Binding ResultCount, StringFormat='{}{0} files'}" 
                                           FontSize="11" Foreground="{StaticResource RicoSubtleBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Results -->
                <ListBox x:Name="ResultsList" Grid.Row="2"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult}"
                         MaxHeight="380" Margin="12,0,12,4"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ResultsList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="8" Padding="12,8" Margin="2,1" 
                                                Background="Transparent" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2a2a4a"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1e3a5f"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RicoAccentBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- File icon -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="#2a2a4a" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IconEmoji}" FontSize="18" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- File info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource RicoTextBrush}"/>
                                    <TextBlock Text="{Binding FilePath}" FontSize="11" 
                                               Foreground="{StaticResource RicoSubtleBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- File size -->
                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" 
                                           FontSize="11" Foreground="{StaticResource RicoSubtleBrush}"
                                           VerticalAlignment="Center" Margin="12,0,4,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <Border Grid.Row="3" Background="#0d1117" CornerRadius="0,0,16,16" Padding="16,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Enter" FontSize="11" Foreground="{StaticResource RicoOrangeBrush}" FontWeight="Bold"/>
                        <TextBlock Text=" open  " FontSize="11" Foreground="{StaticResource RicoSubtleBrush}"/>
                        <TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource RicoOrangeBrush}" FontWeight="Bold"/>
                        <TextBlock Text=" close  " FontSize="11" Foreground="{StaticResource RicoSubtleBrush}"/>
                        <TextBlock Text="Ctrl+Shift+F" FontSize="11" Foreground="{StaticResource RicoOrangeBrush}" FontWeight="Bold"/>
                        <TextBlock Text=" toggle" FontSize="11" Foreground="{StaticResource RicoSubtleBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
