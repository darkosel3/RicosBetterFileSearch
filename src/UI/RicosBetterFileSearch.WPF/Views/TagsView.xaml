<UserControl x:Class="RicosBetterFileSearch.WPF.Views.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RicosBetterFileSearch.WPF.ViewModels">
    <UserControl.DataContext>
        <x:Static Member="vm:ViewModelLocator.Tags" />
    </UserControl.DataContext>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Tags management -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Tagovi" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                         Width="150" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                <TextBox Text="{Binding NewTagColor, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                <Button Content="Kreiraj" Command="{Binding CreateTagCommand}" Padding="8,4"/>
            </StackPanel>

            <ListBox ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}"
                     Height="200" Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="2"
                                    Background="{Binding Color}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Obrisi tag" Command="{Binding DeleteTagCommand}" Padding="8,4" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Right: File-tag assignment -->
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Fajlovi" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                     DisplayMemberPath="FileName" Height="150" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Dodeli tag" Command="{Binding AssignTagCommand}" Padding="8,4" Margin="0,0,8,0"/>
                <Button Content="Ukloni tag" Command="{Binding RemoveTagFromFileCommand}" Padding="8,4"/>
            </StackPanel>

            <TextBlock Text="Tagovi na fajlu:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ListBox ItemsSource="{Binding SelectedFileTags}" Height="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="2"
                                    Background="{Binding Color}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
