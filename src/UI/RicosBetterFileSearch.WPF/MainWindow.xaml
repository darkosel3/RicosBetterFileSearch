<Window x:Class="RicosBetterFileSearch.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RicosBetterFileSearch.WPF.Views"
        Title="Rico's Better File Search" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <TabControl>
            <TabItem Header="📁 Folders">
                <views:FoldersView />
            </TabItem>
            <TabItem Header="🔍 Search">
                <views:SearchView />
            </TabItem>
            <TabItem Header="🏷️ Tags">
                <views:TagsView />
            </TabItem>
            <TabItem Header="📊 Statistics">
                <views:StatisticsView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
